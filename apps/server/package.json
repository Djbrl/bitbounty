{
  "name": "@bitbounty/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=../../.env dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "dev:webhook": "tsx --env-file-if-exists=../../.env src/github/dev-server.ts",
    "payout:smoke": "tsx --env-file-if-exists=../../.env scripts/payout-smoke.ts",
    "lightning:smoke": "tsx --env-file-if-exists=../../.env scripts/lightning-smoke.ts",
    "ngn:smoke": "tsx --env-file-if-exists=../../.env scripts/ngn-smoke.ts"
  },
  "dependencies": {
    "@bitbounty/bitnob": "workspace:*",
    "@bitbounty/core": "workspace:*",
    "@hono/node-server": "^2.1.5",
    "@octokit/app": "^16.1.4",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
