# Copy to .env (never commit .env). Each task adds the variables it needs here.

# --- server (apps/server) ---
# Port the Hono server listens on. Railway sets it automatically.
PORT=8787
# Postgres connection string (Railway Postgres, Neon or Supabase).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/bitbounty

# --- web (apps/web) ---
# URL of the server. Set (BITBOUNTY_API_URL, or NEXT_PUBLIC_API_URL) → every page reads the real
# server; unset → the fixtures (offline dev). See docs/api.md.
NEXT_PUBLIC_API_URL=http://localhost:8787
# BITBOUNTY_API_URL=http://localhost:8787
# Secret shared by the web and the server: the web sends it with the signed-in GitHub login so the
# server can answer /api/me and the maintainer's /api/dashboard. Same value on both. Any long random string.
INTERNAL_API_TOKEN=

# --- Sign in with GitHub (W9) — see docs/auth.md ---
# Next.js reads env from apps/web/: put these in apps/web/.env.local locally, and in Vercel.
# Leave AUTH_SECRET empty to keep auth OFF (every page public, handy for dev on fixtures).
# Secret: generate with `npx auth secret` (or `openssl rand -base64 33`). Never commit it.
AUTH_SECRET=
# Public Client ID of the GitHub App "BitBounty Dakar" (same as GITHUB_CLIENT_ID).
AUTH_GITHUB_ID=Iv23liCkNNOVL2DflyZ1
# Secret: app settings → Client secrets → "Generate a new client secret". Never commit it.
AUTH_GITHUB_SECRET=
# Only for `next start` outside Vercel: trust the Host header. Not needed on Vercel or in `next dev`.
# AUTH_TRUST_HOST=true

# --- GitHub App (F6) — see docs/github-app.md ---
# Public, non-secret values of the registered app "BitBounty Dakar" (slug bitbounty-dakar)
GITHUB_APP_ID=5360174
GITHUB_CLIENT_ID=Iv23liCkNNOVL2DflyZ1
# smee.io channel the app delivers webhooks to (the Docker `smee` service forwards it to /webhooks/github).
# Smee channels have no auth: anyone with the URL can read every payload. Never commit the real one.
WEBHOOK_PROXY_URL=https://smee.io/<your-channel>
# Secrets: set them in your local .env / Railway, never commit them.
# Must equal the "Webhook secret" in the app settings (generate: openssl rand -hex 32)
GITHUB_WEBHOOK_SECRET=
# Private key (.pem) from the app settings. One line with literal \n, or base64 of the .pem file.
GITHUB_PRIVATE_KEY=

# --- Bitnob (F5) — see docs/bitnob-api.md ---
# Same Client ID for sandbox and production; the secret decides the environment.
BITNOB_CLIENT_ID=
# Secret: set it in your local .env / Railway, never commit it.
BITNOB_CLIENT_SECRET=
# Optional, defaults to https://api.bitnob.com
BITNOB_BASE_URL=
# Webhook secret from the Bitnob dashboard (Paramètres → Webhooks). Verifies x-bitnob-signature (B5).
BITNOB_WEBHOOK_SECRET=
# Lightning payouts (B6): the network payout invoices must be on. Empty = testnet (what the Bitnob
# sandbox pays, lntb…); set bitcoin (or mainnet) with production keys. Anything else refuses to start.
LIGHTNING_NETWORK=
# Hard cap on one payout in sats (default 100000). Above it the payout is refused, not retried.
MAX_PAYOUT_SATS=
# Optional Bitnob customer_id sent with every POST /api/lightning/pay (the v2 spec lists it as required).
# Set it only if Bitnob refuses payments without one: create one customer (POST /api/customers), paste its id.
BITNOB_PAYOUT_CUSTOMER_ID=
# Mobile money (legacy B2/B3, only B3's test-payout smoke script still uses these three):
# Public URL of POST /webhooks/bitnob, sent as callback_url on a mobile money payout.
BITNOB_CALLBACK_URL=
# Asset we hold and pay out from: USDT (default) or BTC.
BITNOB_PAYOUT_ASSET=USDT
# Fallback mobile money bank_codes per country, used when GET /api/payouts/banks/<CC> lists none
# (the sandbox answers {"banks":null} for SN). JSON: {"wave":"<code>","orange":"<code>"}.
# No defaults on purpose: confirm the real codes with Bitnob (workshop). Missing code = payout fails with a clear error.
BITNOB_SN_BANK_CODES=

# --- Claude verifier (A1) — apps/server/src/ai/verifier ---
# Secret: Anthropic API key. Leave empty to use the offline fake verifier (tests, demo).
ANTHROPIC_API_KEY=
# Optional, defaults to claude-sonnet-5-5
VERIFIER_MODEL=
# A3 "Price my backlog": optional model override (defaults to VERIFIER_MODEL), and an optional
# GitHub token to raise the 60 requests per hour limit. Use a fine-grained, read-only token limited
# to public repos: the route has no user session yet, so anything this token can read, callers can price.
BACKLOG_MODEL=
BACKLOG_GITHUB_TOKEN=

# --- Agents as funders (A4) — apps/server/src/agents, packages/mcp ---
# JSON array of agents allowed to call /v1 with a bb_ key (only the key's hash is stored).
# Create an entry with: pnpm --filter @bitbounty/server agent:create (see docs/agents.md). Empty = no agent.
BITBOUNTY_AGENTS=
# For the MCP server (packages/mcp), on the agent's machine, not the server:
# BITBOUNTY_API_URL=http://localhost:8787
# BITBOUNTY_AGENT_KEY=bb_...

# --- GitHub bot wiring (G3) ---
# Web app origin used for the links in the bot's status comment (/pay, /b, /me).
WEB_BASE_URL=https://bitbounty-app.vercel.app
# Language of the status comment: en (default) or fr.
BOT_LANG=en
# Optional: the app's bot login, e.g. bitbounty-dakar[bot]. Only its comments count as the status comment.
GITHUB_BOT_LOGIN=

# --- Verification check run (A2) — apps/server/src/ai/check-run ---
# Demo only: "issue" treats any issue a PR closes ("Fixes #n") as funded, criteria from its
# "Done when" section, until F3 stores real bounties. Leave empty in production.
CHECK_RUN_DEMO_LOOKUP=

# --- Claim timer (G5) ---
# How long a /claim lasts, in minutes. Empty = 72 h. The demo uses 5. /extend adds the same again, once.
CLAIM_TTL_MINUTES=
# DEV ONLY. When set, POST /dev/fund (Authorization: Bearer <token>, body {"repo":"owner/name","issue":16})
# marks a bounty as funded without Bitnob, so /claim works in a live demo. Leave empty in production.
DEV_HOOK_TOKEN=

# --- Settlement / payouts after the merge (I2) ---
# Minutes between "verified" and the payout (product: 1440 = 24 h objection window; demo: 0).
# 0 to 35791, empty = 0; anything else and the server refuses to start. The timer is still in memory
# (payouts themselves are in Postgres since B6): after a restart a still-verified bounty needs /hold then /pay.
OBJECTION_WINDOW_MINUTES=0
# Where to pay each developer: a Lightning Address per GitHub login (B6), until W4/B7 store accounts:
# {"awa-dev":"awa@blink.sv"}   or   {"awa-dev":{"lightningAddress":"awa@blink.sv"}}
# (The old mobile money shape {"provider","phone","name"} still parses but can't be paid any more.)
# A developer with no entry or no Lightning Address: the payout fails at once (not retried) until you add it.
PAYOUT_ACCOUNTS=

# --- Bitnob sandbox proxy (F7) — see docs/bitnob-api.md "F7" ---
# Server side, DEV ONLY. When set, /dev/bitnob/* forwards Bitnob sandbox calls (Authorization: Bearer <token>),
# signed with this server's BITNOB_CLIENT_ID/SECRET. Empty = not mounted (404). Generate: openssl rand -hex 32
DEV_PROXY_TOKEN=
# Teammate side. Set it (with BITNOB_BASE_URL=https://<tunnel>/dev/bitnob) to call Bitnob through the proxy
# without keys: BitnobClient sends the bearer token and skips its own signing. Same value as DEV_PROXY_TOKEN.
BITNOB_PROXY_TOKEN=
# Optional, teammate side: your name in the proxy's log (X-Dev-User).
BITNOB_PROXY_USER=
