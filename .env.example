# Copy to .env (never commit .env). Each task adds the variables it needs here.

# --- server (apps/server) ---
# Port the Hono server listens on. Railway sets it automatically.
PORT=8787
# Postgres connection string (Railway Postgres, Neon or Supabase).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/bitbounty

# --- web (apps/web) ---
# Public URL of the server, used by the web app.
NEXT_PUBLIC_API_URL=http://localhost:8787

# --- Sign in with GitHub (W9) — see docs/auth.md ---
# Next.js reads env from apps/web/: put these in apps/web/.env.local locally, and in Vercel.
# Leave AUTH_SECRET empty to keep auth OFF (every page public, handy for dev on fixtures).
# Secret: generate with `npx auth secret` (or `openssl rand -base64 33`). Never commit it.
AUTH_SECRET=
# Public Client ID of the GitHub App "BitBounty Dakar" (same as GITHUB_CLIENT_ID).
AUTH_GITHUB_ID=Iv23liCkNNOVL2DflyZ1
# Secret: app settings → Client secrets → "Generate a new client secret". Never commit it.
AUTH_GITHUB_SECRET=
# Only for `next start` outside Vercel: trust the Host header. Not needed on Vercel or in `next dev`.
# AUTH_TRUST_HOST=true

# --- GitHub App (F6) — see docs/github-app.md ---
# Public, non-secret values of the registered app "BitBounty Dakar" (slug bitbounty-dakar)
GITHUB_APP_ID=5360174
GITHUB_CLIENT_ID=Iv23liCkNNOVL2DflyZ1
# smee.io channel the app delivers webhooks to in dev (forwarded to /webhooks/github)
WEBHOOK_PROXY_URL=https://smee.io/gk8M8VuUD4ZMaO7A
# Secrets: set them in your local .env / Railway, never commit them.
# Must equal the "Webhook secret" in the app settings (generate: openssl rand -hex 32)
GITHUB_WEBHOOK_SECRET=
# Private key (.pem) from the app settings. One line with literal \n, or base64 of the .pem file.
GITHUB_PRIVATE_KEY=

# --- Bitnob (F5) — see docs/bitnob-api.md ---
# Same Client ID for sandbox and production; the secret decides the environment.
BITNOB_CLIENT_ID=
# Secret: set it in your local .env / Railway, never commit it.
BITNOB_CLIENT_SECRET=
# Optional, defaults to https://api.bitnob.com
BITNOB_BASE_URL=

# --- Claude verifier (A1) — apps/server/src/ai/verifier ---
# Secret: Anthropic API key. Leave empty to use the offline fake verifier (tests, demo).
ANTHROPIC_API_KEY=
# Optional, defaults to claude-sonnet-5-5
VERIFIER_MODEL=

# --- GitHub bot wiring (G3) ---
# Web app origin used for the links in the bot's status comment (/pay, /b, /me).
WEB_BASE_URL=https://bitbounty-app.vercel.app
# Language of the status comment: en (default) or fr.
BOT_LANG=en
# Optional: the app's bot login, e.g. bitbounty-dakar[bot]. Only its comments count as the status comment.
GITHUB_BOT_LOGIN=

# --- Verification check run (A2) — apps/server/src/ai/check-run ---
# Demo only: "issue" treats any issue a PR closes ("Fixes #n") as funded, criteria from its
# "Done when" section, until F3 stores real bounties. Leave empty in production.
CHECK_RUN_DEMO_LOOKUP=
