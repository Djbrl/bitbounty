{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "buildCommand": "pnpm --filter \"@bitbounty/server...\" build",
    "watchPatterns": ["apps/server/**", "packages/**", "pnpm-lock.yaml", "railway.json"]
  },
  "deploy": {
    "startCommand": "pnpm --filter @bitbounty/server start",
    "healthcheckPath": "/health",
    "restartPolicyType": "ON_FAILURE"
  }
}
